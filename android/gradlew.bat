@if "%DEBUG%"=="" @echo off
@rem ##########################################################################
@rem
@rem  Gradle startup script for Windows
@rem
@rem ##########################################################################

@rem Set local scope for the variables with windows NT shell
if "%OS%"=="Windows_NT" setlocal

set DIRNAME=%~dp0
if "%DIRNAME%"=="" set DIRNAME=.
set APP_BASE_NAME=%~n0
set APP_HOME=%DIRNAME%

@rem Resolve any "." and ".." in APP_HOME to make it shorter.
for %%i in ("%APP_HOME%") do set APP_HOME=%%~fi

@rem Execute Gradle
echo [Zoya Assistant] Building Android APK with Gradle...
gradle %*
if ERRORLEVEL 1 goto fail
goto success

:fail
echo.
echo [ERROR] Gradle build failed. Please ensure JDK 17+ and Android SDK 35 are installed.
exit /b 1

:success
echo.
echo [SUCCESS] APK built successfully at app/build/outputs/apk/release/app-release.apk
exit /b 0
